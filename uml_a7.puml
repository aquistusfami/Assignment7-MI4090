@startuml uml_a7

!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName DejaVu Sans
skinparam dpi 300
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 45
hide circle
hide empty members

enum DeviceStatus {
  Available
  Borrowed
  UnderMaintenance
}

abstract class TeachingDevice <<abstract>> {
  + Id : string
  + Name : string
  + StoragingLocation : string
  + Status : DeviceStatus
  + TeachingDevice(id : string, name : string,\n  storedAt : string)
  + {abstract} IsReadyForUse() : bool
  + {abstract} GetDefaultPriorityScore() : double
  + Borrow() : void
  + Return() : void 
}

interface IRepository<T> <<interface>> {
  + Add (item : T) : void
  + Remove (id : string) : bool
  + FindById(id : string) : T?
  + GetAll() : IReadOnlyList<T>
  + FindAll(condition : Predicate<T>) : IReadOnlyList<T>
}


class "InMemoryRepository<T>" as InMemoryRepository {
  -items : List<T>
  +Add(item : T) : void
  +Remove(id : string) : bool
  +FindById(id : string) : T?
  +GetAll() : IReadOnlyList<T>
  +FindAll(condition : Predicate<T>) : IReadOnlyList<T>
}

interface ISelectionStrategy<T> <<interface>> 
{
  + Select(candidates : IReadOnlyList<T>) : T 
}

class HighestPriorityStrategy<T> 
{
  - scoreSelector : Func<T, double>
  + HighestPriorityStrategy(scoreSelector : Func<T, double>)
  + Select(candidates : IReadOnlyList<T>) : T
}

class FirstAvailableStrategy<T>
{
  + Select(candidates : IReadOnlyList<T>) : T
}

class AllocationService<T>
{
  - repository : IRepository<T>
  - strategy : ISelectionStrategy<T>

  + AllocationService(repository : IRepository<T>, \n strategy : ISelectionStrategy<T>)
  + ChangeStrategy(newStrategy : ISelectionStrategy<T>) : void 
  + Allocate(additionalCondition : Predicate<T>) : T
}

class ACRemote {
  + CompatibleRooms : IReadOnlySet<string>
  + ACRemote(id : string, name : string,\n  storedAt : string,\n  compatibleRooms : IEnumerable<string>)
  + IsCompatibleWith(roomId : string) : bool
  + IsReadyForUse() : bool 
  + GetDefaultPriorityScore() : double
}

class Micro {
  + BatteryLevel : int
  + SignalQuality : int
  + Micro(id : string, name : string,\n  storedAt : string,\n  batteryLevel : int, signalQuality : int)
  + IsReadyForUse() : bool 
  + GetDefaultPriorityScore() : double
}

class ProjectorRemote {
  + BatteryLevel : int
  + ProjectorRemote(id : string, name : string,\n  storedAt : string,\n  batteryLevel : int)
  + IsReadyForUse() : bool 
  + GetDefaultPriorityScore() : double
}

interface IIdentifiable <<interface>> 
{
  + Id : string
}

IRepository ..> IIdentifiable : <<constrains T>>
TeachingDevice ..|> IIdentifiable
TeachingDevice <|-- ACRemote
TeachingDevice <|-- Micro
TeachingDevice <|-- ProjectorRemote

TeachingDevice ..> DeviceStatus : <<use>>
IRepository <|.. InMemoryRepository
ISelectionStrategy <|.. HighestPriorityStrategy
ISelectionStrategy <|.. FirstAvailableStrategy
AllocationService ..> TeachingDevice : <<constrains T>>
AllocationService --> IRepository : repository
AllocationService --> ISelectionStrategy : strategy


class Exception
class BorrowingException {
  + BorrowingException(message : string)
  + BorrowingException(message : string,\n  innerException : Exception)
}

class DuplicateIdException {
  + DuplicateId : string
  + DuplicateIdException(duplicateId : string)
}

class NoSuitableItemException {
  + NoSuitableItemException()
}

class DeviceNotReadyException {
  + DeviceId : string
  + CurrentStatus : DeviceStatus
  + DeviceNotReadyException(deviceId : string,\n  currentStatus : DeviceStatus)
}

Exception <|-- BorrowingException
BorrowingException <|-- DuplicateIdException
BorrowingException <|-- NoSuitableItemException
BorrowingException <|-- DeviceNotReadyException
@enduml
